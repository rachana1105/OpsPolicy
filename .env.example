# --- Core ---
APP_NAME=OpsPolicy
APP_VERSION=1.0.0
ENVIRONMENT=development

# --- Database / cache ---
DATABASE_URL=postgresql+psycopg2://opspolicy:opspolicy@postgres:5432/opspolicy
REDIS_URL=redis://redis:6379/0

# --- Auth ---
JWT_SECRET=change-me-in-production-please
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=480

# --- CORS ---
CORS_ORIGINS=http://localhost:5173

# --- Analytics provider: "mock" or "databricks" ---
ANALYTICS_PROVIDER=mock
DATABRICKS_HOST=
DATABRICKS_TOKEN=

# --- Lifecycle timings (seconds). Short values keep demos fast. ---
REVOCATION_RETRY_DELAYS=60,300,900
SLA_ESCALATION_ENABLED=true
